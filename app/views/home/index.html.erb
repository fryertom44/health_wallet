<%= turbo_stream_from "import_assessments_channel" %>

<div id="assessment-import-notice"></div>

<div class="home-container">

  <div class="home-card">
    <h1>Health Wallet</h1>
    <p>Manage patient records and assessments</p>

    <%= link_to "View Patients", patients_path, class: "home-link" %>

    <p>
      <%= form_with url: import_assessments_path do |f| %>
        <%= f.file_field :file, accept: 'text/plain', style: "float: right; padding-bottom: 5px" %>
        <br />
        <%= f.submit "Import Assessments", class: "home-link" %>
      <% end %>
    </p>
  </div>
</div>
